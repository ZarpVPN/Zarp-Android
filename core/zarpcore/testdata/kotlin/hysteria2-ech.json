{
    "host": "server.example.com",
    "address": "203.0.113.5",
    "port": 443,
    "quic": true,
    "config": {
        "log": {
            "disabled": true
        },
        "inbounds": [
            {
                "type": "socks",
                "tag": "in",
                "listen": "127.0.0.1",
                "listen_port": 0
            }
        ],
        "outbounds": [
            {
                "type": "hysteria2",
                "tag": "proxy",
                "server": "server.example.com",
                "server_port": 443,
                "detour": "server-dial",
                "connect_timeout": "15s",
                "password": "test-password",
                "tls": {
                    "enabled": true,
                    "server_name": "server.example.com",
                    "insecure": false,
                    "ech": {
                        "enabled": true,
                        "config": [
                            "-----BEGIN ECH CONFIGS-----",
                            "AGT+DQBgAAAgACDQZFLoHh1xlPP29uOXeX+5/9lB5fpBFIBzpBXF/V+GVgAkAAEA",
                            "AQABAAIAAQADAAIAAQACAAIAAgADAAMAAQADAAIAAwADABFjb3Zlci5leGFtcGxl",
                            "LmNvbQAA",
                            "-----END ECH CONFIGS-----"
                        ]
                    }
                }
            },
            {
                "type": "zarp-dial",
                "tag": "server-dial",
                "server": "server.example.com",
                "server_port": 443
            },
            {
                "type": "direct",
                "tag": "direct",
                "domain_resolver": "bootstrap"
            }
        ],
        "dns": {
            "servers": [
                {
                    "type": "local",
                    "tag": "bootstrap"
                },
                {
                    "type": "udp",
                    "tag": "remote",
                    "server": "192.0.2.53",
                    "detour": "proxy"
                }
            ],
            "final": "remote",
            "strategy": "prefer_ipv4",
            "reverse_mapping": false
        },
        "route": {
            "final": "proxy",
            "default_domain_resolver": "remote",
            "rules": [
                {
                    "domain": [
                        "www.cloudflare.com"
                    ],
                    "outbound": "proxy"
                }
            ]
        }
    }
}
